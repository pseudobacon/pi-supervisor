{
  "name": "pi-supervisor",
  "version": "0.5.0",
  "description": "A goal oriented pi extension that supervises the chat and steers it towards a defined outcome",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tintinweb/pi-supervisor.git"
  },
  "homepage": "https://github.com/tintinweb/pi-supervisor#readme",
  "bugs": {
    "url": "https://github.com/tintinweb/pi-supervisor/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "supervisor",
    "steering",
    "outcome",
    "agent",
    "productivity"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.0",
    "typebox": "^1.1.24"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:live": "PI_SUPERVISOR_LIVE_MCP=1 vitest run test/live-mcp.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/tintinweb/pi-supervisor/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-supervisor/raw/master/media/screenshot.png"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
}
